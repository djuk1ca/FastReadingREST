# Copy to `.env` (git-ignored) and fill in. Loaded automatically by spring-dotenv.
# In production these are set as Koyeb environment variables instead.

# --- Database (PostgreSQL / Neon) ---------------------------------------
# Note: JDBC URL form, not the psql connection string Neon shows by default.
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# HikariCP pool size. Kept deliberately small: Neon's free tier caps
# concurrent connections and the API runs on a single small Koyeb instance.
DB_POOL_SIZE=2

# --- JWT ----------------------------------------------------------------
# HS256 signing key. MUST be at least 32 bytes / 256 bits or Nimbus refuses
# to build the encoder at startup. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

JWT_ISSUER=fast-reading
JWT_EXP_SECONDS=26297438

# --- Server -------------------------------------------------------------
# Koyeb injects PORT at runtime; locally it defaults to 8080.
PORT=8080
